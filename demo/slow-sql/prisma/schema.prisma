generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  active
  inactive
  pending
}

enum PlanType {
  free
  pro
  enterprise
}

enum ContentStatus {
  draft
  published
  archived
}

model customers {
  id            BigInt         @id @default(autoincrement())
  name          String
  status        CustomerStatus @default(active)
  plan_type     PlanType       @default(free)
  user_count    Int            @default(0)
  content_count Int            @default(0)
  created_at    DateTime       @default(now()) @db.DateTime(0)
  updated_at    DateTime       @updatedAt @db.DateTime(0)

  users    users[]
  contents contents[]

  @@index([status])
  @@index([plan_type])
  @@index([content_count])
  @@index([created_at])
}

model users {
  id          BigInt   @id @default(autoincrement())
  customer_id BigInt
  name        String?
  email       String?
  role        String?
  created_at  DateTime @default(now()) @db.DateTime(0)

  customer customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id], name: "idx_users_customer_id")
}

model contents {
  id          BigInt        @id @default(autoincrement())
  customer_id BigInt
  title       String?
  body        String?       @db.Text
  status      ContentStatus @default(draft)
  created_at  DateTime      @default(now()) @db.DateTime(0)

  customer customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id], name: "idx_contents_customer_id")
}
