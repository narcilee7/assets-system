{
  "name": "slow-sql-demo",
  "version": "1.0.0",
  "description": "B端客户列表接口从慢 SQL 到生产级优化的 Demo",
  "main": "src/app.js",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node prisma/seed.js",
    "db:seed:small": "DATASET=small node prisma/seed.js",
    "db:seed:medium": "DATASET=medium node prisma/seed.js",
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "prisma": "^6.6.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
